{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omega",
  "version": "0.2.2",
  "identifier": "com.omega.workspace",
  "build": {
    "beforeDevCommand": "npm run mobile:bundle",
    "beforeBuildCommand": "npm run mobile:bundle",
    "frontendDist": "../native-dist"
  },
  "app": {
    "windows": [{"label":"main","title":"Omega","width":1180,"height":820,"minWidth":320,"minHeight":480,"dragDropEnabled":false}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"],
    "shortDescription": "同一个工作空间，随处接续",
    "category": "Productivity",
    "macOS": {"minimumSystemVersion":"11.0"},
    "android": {"minSdkVersion":26}
  }
}
