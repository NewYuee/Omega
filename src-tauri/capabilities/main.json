{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local bundled Omega UI only; no remote web pages receive IPC access",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {"identifier":"http:default","allow":[{"url":"https://*:*/api/*"},{"url":"http://*:*/api/*"}]},
    {"identifier":"opener:allow-open-url","allow":[{"url":"https://*"},{"url":"http://*"}]},
    "omega-vault:default"
  ]
}
